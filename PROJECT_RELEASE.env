# vllm-turing 发布元数据单源 (single source of truth)。
# 供 docker/build.sh (source 后作 --build-arg 注入) 与文档共同引用, 消灭
# BASE_IMAGE digest / UPSTREAM_COMMIT 在 build.sh 与 Dockerfile 两处手抄的漂移。
#
# 约定: build.sh 是本文件唯一消费者; Dockerfile 的 ARG 默认值仅作"不经 build.sh
# 直接 docker build"时的兜底, 权威值以本文件为准。改值只改这里。

# ---- 底座镜像 (官方 vllm-openai, pin 到 digest 防 tag 漂移) ----
VLLM_TURING_BASE_IMAGE="vllm/vllm-openai:v0.30.0-cu129@sha256:a67f8f186d4567612ac37a55bd82295006002b18858eb12a8af2f05f86c2ae3f"

# ---- 上游 vLLM 基线 (纯 overlay: 我方不 fork, 覆盖/注入到底座同名路径) ----
VLLM_TURING_UPSTREAM_COMMIT="98dff2a81d747d1dba01a47f939f48c3526d4206"
VLLM_TURING_UPSTREAM_VERSION="0.29.0"

# ---- flash_qla GDN prefill 内核源 commit (预编译 .so 进镜像) ----
VLLM_TURING_FLASHQLA_COMMIT="187b932dbd11940f0bcf52fb3675dd47fd69f313"

# ---- 发布标识 ----
VLLM_TURING_RELEASE="vllm-turing"

# ---- 构建期 jobs 自动钳制 (防低内存构建机 nvcc OOM; 详见 docker/build.sh) ----
# 未显式设 MAX_JOBS 时: auto = min(nproc, floor(可用内存GB / 2), cap)。
VLLM_TURING_BUILD_MAX_JOBS_CAP="8"

# ---- 运行时版本约束 (torch 家族须与底座对齐, 见 Dockerfile 降回 cu129 那段) ----
VLLM_TURING_TORCH_VERSION="2.13.0"
VLLM_TURING_CUDA_TAG="cu129"

# ---- 已验证硬件 (端到端跑通的目标机) ----
# Tesla T10 16GB (sm75): 2x VM 验证 + 8x 真爽一号机 TP8; RTX 2080Ti (sm75): 8x 二号机。
VLLM_TURING_VALIDATED_HW="Tesla T10 16GB sm_75 (2x/8x); RTX 2080Ti sm_75"
